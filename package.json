{
  "name": "oneshell",
  "productName": "OneShell",
  "version": "0.1.0",
  "description": "Samsung One UI (Galaxy Tab S9) style shell for Windows 10 and 11",
  "main": "src/main/main.js",
  "author": "rayan-afkkk",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "dist": "npm run build:native && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.oneshell.app",
    "productName": "OneShell",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "build/native/OneShellNative.exe", "to": "native/OneShellNative.exe" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OneShell"
    }
  }
}
